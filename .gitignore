# Bytecode. Twenty-two of these were committed before this file existed: they
# are whoever-ran-it-last's build products, and they conflict on every pull.
__pycache__/
*.py[cod]

# Virtual environments and build output.
venv/
.venv/
build/
dist/

# Local settings: window geometry, theme, opacity, last scan, layout prefs.
# Machine-specific, and rewritten every time the app closes.
pi_config.json

# Debug log, written only when PI_DEBUG is set.
pi_debug.log

# The compiled executable: 22 MB, rebuilt by `python -m PyInstaller build.spec`.
Eve PI.exe

# Test and screenshot artefacts.
.pytest_cache/
test_output.txt
shots/

# The test suite and the design notes stay in the working copy. The suite is
# 72 files of unittest and Tk smoke scripts that drive the real window, and the
# notes are working documents rather than documentation of the tool; neither
# has ever been part of a release, and both would read as half a project to
# anyone who cloned this one.
tests/
docs/

# Editor, agent and tooling state that travels with the working copy.
.vscode/
.claude/
.superpowers/
.idea/
pyrightconfig.json

# Note on what is deliberately NOT ignored:
#   data/planet_radii.json, data/system_names.json and the cached scan results
#   are caches the app can rebuild, but they ship on purpose so a fresh clone
#   works offline from the first launch.
#   data/pi_icons/ holds the map's structure glyph masks. They are generated by
#   scripts/make_pi_glyphs.py, but they ship too: without them the map falls
#   back to plain vector shapes, which is not what the screenshots show.
